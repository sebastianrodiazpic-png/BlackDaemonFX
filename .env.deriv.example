# Deriv Charts/API es la única fuente de análisis. MT5 ejecuta y gestiona.
DAEMON_MARKET_DATA_PROVIDER=deriv
DAEMON_MARKET_DATA_MODE=shadow

# Endpoint público oficial: no requiere token ni registro API.
DERIV_WEBSOCKET_ENDPOINT=wss://api.derivws.com/trading/v1/options/ws/public

# Sólo agregue equivalencias que el preflight no pueda resolver de forma única.
DAEMON_DERIV_SYMBOL_MAP_JSON={}

# Protección compartida por los 15 workers contra el rate limit público.
# Los valores por defecto son conservadores y normalmente no requieren cambio.
DAEMON_DERIV_MIN_REQUEST_INTERVAL_SECONDS=0.20
DAEMON_DERIV_RATE_LIMIT_RETRIES=4
DAEMON_DERIV_RATE_LIMIT_BACKOFF_SECONDS=0.75
DAEMON_WORKER_START_STAGGER_SECONDS=1.0
DAEMON_WORKER_STALL_TIMEOUT_SECONDS=180

DAEMON_CANDLE_CACHE_TTL_SECONDS=2.0
DAEMON_TICK_CACHE_TTL_SECONDS=0.5
DAEMON_SHADOW_MAX_CLOSE_DIVERGENCE_ATR=0.10
DAEMON_MARKET_DATA_SHADOW_PATH=storage/analysis/market_data_shadow.jsonl
